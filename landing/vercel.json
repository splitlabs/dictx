{
  "rewrites": [
    {
      "source": "/js/script.cookieless.js",
      "destination": "https://datafa.st/js/script.cookieless.js"
    },
    {
      "source": "/api/events",
      "destination": "https://datafa.st/api/events"
    },
    {
      "source": "/buy",
      "destination": "/api/buy"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600"
        }
      ]
    }
  ]
}
